<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ホーム画面ウィジェットの施錠/解錠の成否を振動で伝える（BL-129）。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        操作の経路（Bluetooth直結／インターネット経由）が切り替わったことを知らせる（BL-190）。
        当初はトーストで伝えていたが（BL-168）、2026-09-20の実機検証で、通知が無効な端末では
        背景から出したトーストがシステムに抑止されると判明した。ウィジェット操作もウォッチからの
        操作も背景で動くため、設計意図の場面では一度も出ていなかった。
        許可されなくてもアプリは従来どおり動く（必須にしない）。通知そのものは設定メニューから
        オフにできる（SesameRouteNotificationStore）。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        BLE直接操作（BL-153）。スマートフォンがSesameの電波圏内にあるときだけ使う追加の経路で、
        許可されなくてもアプリは従来どおりWeb API経由で動く（必須にしない）。

        BLUETOOTH_SCAN は近くのSesameを探すためだけに使い、位置情報の推定には使わないため
        neverForLocation を宣言する。これにより API 31 以上では位置情報の許可が不要になる。
        ACCESS_FINE_LOCATION は API 30 以下でBLEスキャンに必須のため、maxSdkVersion="30" を付けて
        旧端末限定にする。位置情報そのものの収集・送信は行わない（DESIGN.md「BLE直接操作の併用方針」論点4）。
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!--
        BLE非搭載の端末でもWeb API経由で動くため、配信対象を狭めないよう required="false" とする。
    -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SesamiWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ホーム画面ウィジェット（BL-121）。対象デバイスの選択画面は追加時に android:configure から開く。 -->
        <receiver
            android:name=".widget.SesameWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sesame_widget_info" />
        </receiver>

        <!-- 同じウィジェットを「2 × 1」としても一覧へ出す（BL-186）。表示・操作は上と同じで初期サイズだけが違う。 -->
        <receiver
            android:name=".widget.SesameWidgetSmallReceiver"
            android:exported="true"
            android:label="@string/widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sesame_widget_small_info" />
        </receiver>

        <activity
            android:name=".widget.WidgetConfigurationActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SesamiWear">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- ウィジェットのタップ操作（BL-122）。自アプリのPendingIntentと解錠確認画面からのみ呼ぶ。 -->
        <receiver
            android:name=".widget.WidgetCommandReceiver"
            android:exported="false" />

        <activity
            android:name=".widget.WidgetUnlockConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SesamiWear.Dialog" />

        <service
            android:name=".messaging.SesameMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/sesami-wear/" />
            </intent-filter>
        </service>
    </application>
</manifest>
